# Example .env — safe to commit, contains no real secrets.
#
# Unprotected: plain values, fine to keep in this file as-is.
TZ=Europe/Berlin

# Protected: the real value lives encrypted at secrets/db_password.enc.
# bin/dockercompose.sh decrypts it to $SECRETS_DIR/db_password at runtime,
# and docker-compose.yaml bind-mounts $SECRETS_DIR to /run/secrets in the
# container, so the app reads the secret from the file path below instead
# of from an env var.
DB_PASSWORD_FILE=/run/secrets/db_password
